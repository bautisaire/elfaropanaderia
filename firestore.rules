rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si es admin
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email != null && (
        request.auth.token.email.lower() == "sairebautista@gmail.com" || 
        request.auth.token.email.lower() == "mariacoronel160478@gmail.com" ||
        request.auth.token.email.lower() == "litijunior@hotmail.com.ar" ||
        request.auth.token.email.lower() == "juampi.sme@outlook.com.ar"
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        request.auth != null && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())).data.get('is_rider', false) == false
      );
    }

    function isRider() {
      return request.auth != null && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())).data.get('is_rider', false) == true;
    }

    // Acceso a Caja/POS: igual que en el frontend (Editor.tsx), se permite si pos_sales
    // no está explícitamente en false, sin excluir a cuentas marcadas is_rider.
    function canPosSales() {
      return isSuperAdmin() || (
        request.auth != null && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())).data.get('pos_sales', true) != false
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity', 'variants', 'stock'])
      );

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos (Seguridad Fuerte)
    match /orders/{orderId} {
      allow get: if true; // Permitir que un cliente lea su propio pedido si conoce el ID exacto
      allow create: if isAdmin(); // El backend procesa pedidos nuevos o Admins locales
      allow list: if isAdmin() || isRider(); // Solo admins y riders pueden listar todos los pedidos
      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.assignedRider == request.auth.token.email
      );
      allow delete: if isAdmin();
    }

    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hero_cards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /raffles/{raffleId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /participants/{participantId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/store_settings {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /config/order_counter {
        allow read: if true;
        allow update: if true; // Frontend incrementa
        allow create: if isAdmin();
    }
    
    match /config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stock_movements/{movementId} {
      allow create: if true; 
      allow read, update, delete: if isAdmin();
    }

    match /stats/general {
      allow read: if isAdmin();
      // Cualquiera puede sumar una visita, pero solo de a 1 y solo en los campos de visitas.
      allow create: if request.resource.data.keys().hasOnly(['visits', 'dailyVisits', 'visitsBySource', 'dailyVisitsBySource'])
        && request.resource.data.visits == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits', 'dailyVisits', 'visitsBySource', 'dailyVisitsBySource'])
        && request.resource.data.visits == resource.data.get('visits', 0) + 1;
    }

    match /stats/{document=**} {
      allow read, write: if isAdmin();
    }

    match /stock_alerts/{alertId} {
      allow read: if isAdmin();
      allow create, update, delete: if true;
    }

    match /rider_extras/{extraId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == resource.data.riderEmail);
      allow write: if isAdmin();
    }

    match /raw_materials/{document=**} {
      allow read, write: if isAdmin();
    }
    match /waste_logs/{document=**} {
      allow read, write: if isAdmin();
    }
    match /recipe_bases/{document=**} {
      allow read, write: if isAdmin();
    }
    match /cif_items/{document=**} {
      allow read, write: if isAdmin();
    }
    match /expenses/{document=**} {
      allow read, write: if isAdmin();
    }
    match /expense_categories/{document=**} {
      allow read, write: if isAdmin();
    }
    match /caja_movements/{document=**} {
      allow read, write: if canPosSales();
    }
    match /caja_sessions/{document=**} {
      allow read, write: if canPosSales();
    }
    // Pagos: superadmin o admins con el permiso "pagos"
    match /finance_config/pagos/{document=**} {
      allow read, write: if isSuperAdmin() || (
        request.auth != null && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())).data.get('pagos', false) == true
      );
    }
    // Perfiles de empleados: además de quien tiene "pagos" (regla de arriba), quien tiene "employees"
    match /finance_config/pagos/empleados/{document=**} {
      allow read, write: if isSuperAdmin() || (
        request.auth != null && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())).data.get('employees', false) == true
      );
    }
    // Finanzas: solo superadmin
    match /finance_config/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    match /finance_closings/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    match /finance_movements/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    match /finance_payables/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    match /time_entries/{document=**} {
      allow read, write: if isAdmin();
    }
    match /notes/{document=**} {
      allow read, write: if isAdmin();
    }
    match /employees/{document=**} {
      allow read, write: if isAdmin();
    }
    match /lista_espera/{document=**} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Ubicación en vivo del repartidor (solo mientras tiene pedidos "enviado").
    // Cada repartidor escribe y borra únicamente su propio documento; los admins lo leen.
    match /rider_locations/{riderEmail} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email.lower() == riderEmail);
      allow delete: if isAdmin() || (request.auth != null && request.auth.token.email.lower() == riderEmail);
      allow create, update: if request.auth != null
        && request.auth.token.email.lower() == riderEmail
        && (isRider() || isAdmin())
        && request.resource.data.keys().hasOnly(['email', 'name', 'lat', 'lng', 'accuracy', 'updatedAt'])
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
    }

    // Clientes (id = teléfono normalizado): notas y ubicaciones fijadas por dirección.
    // Los repartidores solo leen, para ver en su mapa la ubicación guardada.
    match /customers/{phone} {
      allow read: if isAdmin() || isRider();
      allow write: if isAdmin();
    }

    match /admin_roles/{roleId} {
      // Cada uno lee su rol y el superadmin lee todos. Con el permiso "riders_view" se pueden
      // leer SOLO los roles de repartidores (para elegirlos en los extras de delivery).
      allow read: if request.auth != null && (request.auth.token.email != null && request.auth.token.email.lower() == roleId || isSuperAdmin() || (
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email.lower())).data.get('riders_view', false) == true &&
        resource.data.is_rider == true
      ));
      allow write: if isSuperAdmin();
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }

    match /users/{userId} {
      // Un usuario solo puede leer/escribir sus propios datos, admins pueden leer todo
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  } 
}
