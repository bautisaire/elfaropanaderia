{
    "rewrites": [
        {
            "source": "/__/auth/:path*",
            "destination": "https://el-faro-panaderia.firebaseapp.com/__/auth/:path*"
        },
        {
            "source": "/__/firebase/:path*",
            "destination": "https://el-faro-panaderia.firebaseapp.com/__/firebase/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        }
    ]
}